 /***********************************************************************
+ *           MmCopyMemory   (NTOSKRNL.EXE.@)
+ */
+NTSTATUS WINAPI MmCopyMemory(void *target, MM_COPY_ADDRESS source, SIZE_T size, ULONG flags, SIZE_T *copied)
+{
+    const char *src = source.VirtualAddress;
+    char *dst = target;
+    NTSTATUS status;
+
+    TRACE("target %p, source %s, size %Iu, flags %#lx, copied %p\n",
+          target, wine_dbgstr_longlong(source.PhysicalAddress.QuadPart), size, flags, copied);
+
+    if (!copied) return STATUS_INVALID_PARAMETER;
+    *copied = 0;
+    if (flags != MM_COPY_MEMORY_VIRTUAL && flags != MM_COPY_MEMORY_PHYSICAL)
+        return STATUS_INVALID_PARAMETER;
+    /* Wine has no access to the host's physical RAM. Never substitute a virtual
+     * address or report an unread physical range as successfully copied. */
+    if (flags == MM_COPY_MEMORY_PHYSICAL) return STATUS_NOT_SUPPORTED;
+    if ((ULONG_PTR)src + size < (ULONG_PTR)src || (ULONG_PTR)dst + size < (ULONG_PTR)dst)
+        return STATUS_INVALID_PARAMETER;
+
+    while (*copied < size)
+    {
+        SIZE_T chunk = min(size - *copied, PAGE_SIZE - BYTE_OFFSET(src)), read = 0;
+
+        status = NtReadVirtualMemory(NtCurrentProcess(), src, dst, chunk, &read);
+        *copied += read;
+        if (status || read != chunk) return *copied || !status ? STATUS_PARTIAL_COPY : status;
+        src += read;
+        dst += read;
+    }
+    return STATUS_SUCCESS;
+}
