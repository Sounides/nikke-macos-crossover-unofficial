+/* CEF rendering switches documented by kanata-dp/nikke-crossover-compat,
+ * docs/UPDATE-2026-09-26.en.md, 8f3c77b131d0 (LGPL-2.1-or-later).
+ * Opt in for the verification service only; retain its official executable,
+ * authentication flow, sandbox and certificate validation. */
+static BOOL command_line_has_switch( const WCHAR *cmdline, const WCHAR *option )
+{
+    const WCHAR *match = cmdline;
+    SIZE_T length = wcslen( option );
+
+    while ((match = wcsstr( match, option )))
+    {
+        WCHAR next = match[length];
+        if ((match == cmdline || match[-1] == ' ' || match[-1] == '\t' || match[-1] == '"') &&
+            (!next || next == ' ' || next == '\t' || next == '"')) return TRUE;
+        match += length;
+    }
+    return FALSE;
+}
