+static WCHAR *verification_command_line( const WCHAR *image, const WCHAR *cmdline )
+{
+    static const WCHAR *const options[] =
+    {
+        L"--disable-gpu", L"--disable-gpu-compositing", L"--in-process-gpu"
+    };
+    const WCHAR *base = wcsrchr( image, '\\' );
+    WCHAR flag[2], *result, *end;
+    SIZE_T length, extra = 0;
+    unsigned int i;
+
+    base = base ? base + 1 : image;
+    if (!cmdline || wcsicmp( base, L"intl_service.exe" ) ||
+        GetEnvironmentVariableW( L"NIKKE_CEF_SOFTWARE", flag, ARRAY_SIZE(flag) ) != 1 || flag[0] != '1') return NULL;
+    length = wcslen( cmdline );
+    for (i = 0; i < ARRAY_SIZE(options); ++i)
+        if (!command_line_has_switch( cmdline, options[i] )) extra += 1 + wcslen( options[i] );
+    if (!extra || length + extra > 32766) return NULL;
+    if (!(result = RtlAllocateHeap( GetProcessHeap(), 0, (length + extra + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( result, cmdline, length * sizeof(WCHAR) );
+    end = result + length;
+    for (i = 0; i < ARRAY_SIZE(options); ++i)
+    {
+        if (command_line_has_switch( cmdline, options[i] )) continue;
+        *end++ = ' ';
+        wcscpy( end, options[i] );
+        end += wcslen( options[i] );
+    }
+    *end = 0;
+    return result;
+}
