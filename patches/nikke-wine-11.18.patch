+/* Opt-in diagnostics: only presentation timing and surface metadata are written.
+ * Use the drawable's actual presentation time, rather than CPU submit frequency. */
+static FILE *open_presentation_metrics(const char *path)
+{
+    int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    FILE *file;
+    if (fd < 0 && errno == EEXIST)
+    {
+        char *unique;
+        if (asprintf(&unique, "%s.XXXXXX", path) < 0) return NULL;
+        fd = mkstemp(unique);
+        free(unique);
+        if (fd >= 0) fcntl(fd, F_SETFD, FD_CLOEXEC);
+    }
+    if (fd < 0) return NULL;
+    if (!(file = fdopen(fd, "w"))) close(fd);
