+/* Close at most one Win32-pixel gap at a remote surface's outer edge. Changing the
+ * host's frame alone does not resize its CAContext contents: transform the original
+ * surface instead, keeping interior siblings and zero-area surfaces untouched. */
+static CGRect snap_host_frame_to_view_edges(CGRect frame, CGRect view)
+{
+    const CGFloat px = retina_on ? 0.5 : 1.0;
+    CGFloat min_x = CGRectGetMinX(view), min_y = CGRectGetMinY(view);
+    CGFloat max_x = CGRectGetMaxX(view), max_y = CGRectGetMaxY(view);
+
+    if (CGRectIsEmpty(frame) || CGRectIsEmpty(view)) return frame;
+    if (frame.origin.x > min_x && frame.origin.x - min_x <= px)
+    {
+        frame.size.width += frame.origin.x - min_x;
+        frame.origin.x = min_x;
+    }
+    if (frame.origin.y > min_y && frame.origin.y - min_y <= px)
+    {
+        frame.size.height += frame.origin.y - min_y;
+        frame.origin.y = min_y;
+    }
+    if (fabs(CGRectGetMaxX(frame) - max_x) <= px)
+        frame.size.width = max_x - frame.origin.x;
+    if (fabs(CGRectGetMaxY(frame) - max_y) <= px)
+        frame.size.height = max_y - frame.origin.y;
+    return frame;
+}
+
+static void set_host_surface_frame(CALayerHost *host, CGRect frame, CGRect view)
+{
+    CGRect snapped = snap_host_frame_to_view_edges(frame, view);
+    host.transform = CATransform3DIdentity;
+    host.bounds = CGRectMake(0, 0, frame.size.width, frame.size.height);
+    host.position = CGPointMake(CGRectGetMidX(snapped), CGRectGetMidY(snapped));
+    host.transform = CATransform3DMakeScale(snapped.size.width / frame.size.width,
+                                          snapped.size.height / frame.size.height, 1.0);
+}
